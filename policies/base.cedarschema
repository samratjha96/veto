// Veto Cedar schema — simplified stateless per-action evaluation.
//
// No Trajectory, Message, Label, Taint, or File entities.
// Entities are built fresh per request.

// Principal: the AI coding agent.
entity Agent = {
    provider_id: String,
};

// Resource: generic resource for all actions.
entity Resource;

// YARA scan results.
type SignatureContext = {
    match_count: Long,
    categories: Set<String>,
    severity: Long,
};

// Process context for kill-command awareness.
type ProcessContext = {
    has_long_running_process: Bool,
    longest_process_runtime_seconds: Long,
};

// ShellCommand context (pre-execution).
type ShellCommandContext = {
    command: String,
    // Resolved by the shell parser; subcommand and flags are empty unless a
    // command spec describes the program (see src/command_spec.rs).
    program: String,
    subcommand: String,
    flags: Set<String>,
    working_dir: String,
    // The program talks to the network (curl, wget, ssh, ...).
    network: Bool,
    // The host it talks to, if an argument names one.
    host: String,
    // It sends local data to a host off this machine and network.
    uploads: Bool,
    // It downloads from a host off this machine and network.
    web_read: Bool,
    // An argument is a credential path.
    sensitive: Bool,
    signature: SignatureContext,
    has_long_running_process: Bool,
    longest_process_runtime_seconds: Long,
};

action "ShellCommand" appliesTo {
    principal: [Agent],
    resource: [Resource],
    context: ShellCommandContext,
};

// WebFetch context (pre-execution).
type WebFetchContext = {
    url: String,
    signature: SignatureContext,
};

action "WebFetch" appliesTo {
    principal: [Agent],
    resource: [Resource],
    context: WebFetchContext,
};

// File operation contexts.
type FileReadContext = {
    path: String,
    // The path holds credentials.
    sensitive: Bool,
    signature: SignatureContext,
};

action "FileRead" appliesTo {
    principal: [Agent],
    resource: [Resource],
    context: FileReadContext,
};

type FileWriteContext = {
    path: String,
    // The path holds credentials.
    sensitive: Bool,
    signature: SignatureContext,
};

action "FileWrite" appliesTo {
    principal: [Agent],
    resource: [Resource],
    context: FileWriteContext,
};

type FileEditContext = {
    path: String,
    // The path holds credentials.
    sensitive: Bool,
    signature: SignatureContext,
};

action "FileEdit" appliesTo {
    principal: [Agent],
    resource: [Resource],
    context: FileEditContext,
};

type FileDeleteContext = {
    path: String,
    // The path holds credentials.
    sensitive: Bool,
    signature: SignatureContext,
};

action "FileDelete" appliesTo {
    principal: [Agent],
    resource: [Resource],
    context: FileDeleteContext,
};
